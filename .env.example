# Application
APP_NAME="Report Generation System"
APP_VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=true
SECRET_KEY="change-me-in-production-use-random-64-char-string"

# Database
DATABASE_URL="postgresql+asyncpg://reportgen:reportgen@localhost:5432/reportgen"
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_ECHO=false

# Redis Cache
REDIS_URL="redis://localhost:6379/0"
REDIS_CACHE_TTL=86400

# API Configuration
API_HOST="0.0.0.0"
API_PORT=8000
API_RELOAD=true
CORS_ORIGINS="http://localhost:3000,http://localhost:8000"

# Ontology Parser
ONTOLOGY_MAX_FILE_SIZE_MB=100
ONTOLOGY_TIMEOUT_SECONDS=300
ONTOLOGY_CACHE_ENABLED=true
ONTOLOGY_CACHE_TTL_HOURS=24

# LLM Configuration - OpenAI
OPENAI_API_KEY="sk-your-openai-key-here"
OPENAI_MODEL="gpt-4"
OPENAI_MAX_TOKENS=4000
OPENAI_TEMPERATURE=0.7
OPENAI_ENABLED=true

# LLM Configuration - Anthropic
ANTHROPIC_API_KEY="sk-ant-your-anthropic-key-here"
ANTHROPIC_MODEL="claude-sonnet-4-20250514"
ANTHROPIC_MAX_TOKENS=4000
ANTHROPIC_TEMPERATURE=0.7
ANTHROPIC_ENABLED=false

# LLM Configuration - Local
LOCAL_LLM_ENABLED=false
LOCAL_LLM_ENDPOINT="http://localhost:11434"
LOCAL_LLM_MODEL="llama2"

# Research Services
WEB_SEARCH_ENABLED=true
WEB_SEARCH_API_KEY="your-search-api-key"
ACADEMIC_API_ENABLED=true
ACADEMIC_API_KEY="your-academic-api-key"
WIKIDATA_ENABLED=true

# Content Generation
CONTENT_MIN_QUALITY_SCORE=75.0
CONTENT_MIN_READABILITY=60.0
CONTENT_TEMPERATURE=0.7

# Cost Limits
LLM_PER_REQUEST_MAX_USD=0.50
LLM_DAILY_MAX_USD=100.00

# Quality Thresholds
QUALITY_MIN_COMPLETENESS=80.0
QUALITY_MIN_CITATION_COVERAGE=90.0
QUALITY_MIN_ACCESSIBILITY=85.0

# Logging
LOG_LEVEL="INFO"
LOG_FORMAT="json"

# Celery (Task Queue)
CELERY_BROKER_URL="redis://localhost:6379/1"
CELERY_RESULT_BACKEND="redis://localhost:6379/2"

# Monitoring
METRICS_ENABLED=true
METRICS_PORT=9090
