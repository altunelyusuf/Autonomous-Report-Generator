# Database Configuration
DATABASE_URL=postgresql+asyncpg://reportgen:reportgen@localhost:5432/reportgen

# Redis Cache
REDIS_URL=redis://localhost:6379/0

# LLM API Keys
OPENAI_API_KEY=sk-your-openai-api-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# Research API Keys (Optional)
WEB_SEARCH_API_KEY=your-web-search-api-key
ACADEMIC_API_KEY=your-academic-api-key

# Application Settings
APP_NAME=Autonomous Report Generator
APP_VERSION=1.0.0
APP_ENV=development
LOG_LEVEL=INFO

# API Server
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_RELOAD=true

# Paths
CACHE_DIR=/app/data/cache
EXPORT_DIR=/app/data/exports
LOG_DIR=/app/logs

# Cache Settings
CACHE_TTL=3600
MAX_CACHE_SIZE=1000
FILE_CACHE_MAX_SIZE_MB=500

# Quality Settings
QUALITY_THRESHOLD=75.0
CONTENT_THRESHOLD=70.0
CITATION_THRESHOLD=70.0
STRUCTURE_THRESHOLD=70.0
READABILITY_THRESHOLD=60.0

# Export Settings
MAX_EXPORT_FILE_SIZE_MB=100

# Security (Production)
# JWT_SECRET=your-random-secret-key-here
# ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# Monitoring
METRICS_ENABLED=true
PROMETHEUS_PORT=9090
HEALTH_CHECK_INTERVAL=30

# Performance
MAX_CONCURRENT_REPORTS=10
REQUEST_TIMEOUT=300
MAX_UPLOAD_SIZE_MB=50
