# Kubernetes Secrets Template
# DO NOT commit actual secrets to version control
# Copy this file to secrets.yaml and replace placeholders with actual values

apiVersion: v1
kind: Secret
metadata:
  name: report-generator-secrets
  labels:
    app: report-generator
type: Opaque
stringData:
  # Database connection
  database-url: "postgresql+asyncpg://user:password@postgres:5432/reportgen"

  # LLM API Keys
  openai-api-key: "sk-your-openai-api-key-here"
  anthropic-api-key: "sk-ant-your-anthropic-api-key-here"

  # Research API Keys (optional)
  web-search-api-key: "your-web-search-api-key"
  academic-api-key: "your-academic-api-key"

  # JWT Secret for authentication (if implemented)
  jwt-secret: "your-random-jwt-secret-key-here"

---
# To create the secret from command line:
# kubectl create secret generic report-generator-secrets \
#   --from-literal=database-url='postgresql+asyncpg://user:password@postgres:5432/reportgen' \
#   --from-literal=openai-api-key='sk-your-key' \
#   --from-literal=anthropic-api-key='sk-ant-your-key'
